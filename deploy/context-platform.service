[Unit]
Description=Context Platform Host
After=network.target redis-server.service
# Soft dependency only -- most installs don't run Redis at all (CONTEXT_PLATFORM_REDIS unset means
# JobDispatcher's IJobSignal falls back to its single-process in-memory default), and systemd
# tolerates ordering against a unit that doesn't exist on this box. Wants (not Requires) so a
# missing/failed redis-server never blocks this service from starting.
Wants=redis-server.service

[Service]
# UseSystemd() in Program.cs sends the READY=1 notification this Type expects.
Type=notify
# Optional -- port/data-dir overrides only. No per-project config here any more: Context.Dashboard.Server
# is multi-tenant (projects are added at runtime via POST /api/projects), so this is one shared,
# always-on instance rather than one service per project. The leading '-' makes a missing file a
# no-op instead of a startup failure (a fresh install has nothing to override yet).
EnvironmentFile=-/etc/context-platform/context-platform.env
ExecStart=/opt/context-platform/Context.Dashboard.Server
WorkingDirectory=/opt/context-platform
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
