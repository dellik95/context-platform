<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-scoped NuGet sources: this solution only needs nuget.org, and the machine's other
  configured sources (an internal corporate feed) are frequently unreachable from here, making
  every restore hang on repeated timeout/retry against them before falling through to nuget.org.
  <clear /> resets the source list for anything restored from within this repo specifically;
  it does not touch the user/machine-wide NuGet.Config other solutions on this machine still use.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
