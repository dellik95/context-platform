{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \u0022$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\u0022"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \u0022$CLAUDE_PROJECT_DIR/.claude/hooks/user-prompt-submit.sh\u0022"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \u0022$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-use.sh\u0022"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \u0022$CLAUDE_PROJECT_DIR/.claude/hooks/session-end.sh\u0022"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \u0022$CLAUDE_PROJECT_DIR/.claude/hooks/post-compact.sh\u0022"
          }
        ]
      }
    ]
  }
}
