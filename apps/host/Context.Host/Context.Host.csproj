<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Context.Application\Context.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Context.Infrastructure\Context.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Context.Claude\Context.Claude.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>context-platform-host</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Builds the Angular Dashboard (apps/dashboard) as part of this project's own build/publish,
    the same way the classic `dotnet new angular` template wired an SPA into an ASP.NET Core host:
    a pre-Build target runs `ng build` (skipped via MSBuild's own Inputs/Outputs staleness check
    when the Dashboard's source hasn't changed, so an unrelated backend-only rebuild stays fast),
    copies the result into wwwroot/ (served by Program.cs's UseStaticFiles/MapFallbackToFile), and
    a ComputeFilesToPublish hook re-adds those files to the publish output — required because the
    Web SDK's own implicit "wwwroot/**" Content glob is evaluated before this target ever runs, so
    files that only start existing in wwwroot during THIS build would otherwise be silently
    dropped from a `dotnet publish`.
    Set -p:SkipDashboardBuild=true to opt out (e.g. an environment with no Node/npm installed).
  -->
  <PropertyGroup>
    <SpaRoot>$(MSBuildProjectDirectory)\..\..\dashboard\</SpaRoot>
    <DashboardDistDir>$(SpaRoot)dist\dashboard\browser\</DashboardDistDir>
    <SkipDashboardBuild Condition="'$(SkipDashboardBuild)' == ''">false</SkipDashboardBuild>
  </PropertyGroup>

  <ItemGroup>
    <DashboardSourceFiles Include="$(SpaRoot)src\**\*.*" Condition="Exists('$(SpaRoot)src')" />
  </ItemGroup>

  <Target Name="BuildDashboard" BeforeTargets="Build"
          Condition="'$(SkipDashboardBuild)' != 'true' AND Exists('$(SpaRoot)package.json')"
          Inputs="@(DashboardSourceFiles);$(SpaRoot)package.json;$(SpaRoot)angular.json"
          Outputs="$(DashboardDistDir)index.html">
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec Command="npx ng build" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <Target Name="CopyDashboardToWwwroot" AfterTargets="BuildDashboard"
          Condition="'$(SkipDashboardBuild)' != 'true' AND Exists('$(DashboardDistDir)index.html')">
    <ItemGroup>
      <DashboardDistFiles Include="$(DashboardDistDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DashboardDistFiles)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Plain `dotnet build`/`dotnet run` never runs ComputeFilesToPublish (that's a publish-only
    target), so without this, wwwroot/ only ever gets populated in the SOURCE tree
    (CopyDashboardToWwwroot's target) - never in the bin output directory, which is what actually
    gets served: Program.cs pins ContentRootPath to AppContext.BaseDirectory (the bin dir), not the
    source tree. Confirmed live: a fresh `dotnet run` 404'd on "/" until this copy existed. Runs
    after the main Build target so $(OutDir) already has everything else in it.
  -->
  <Target Name="CopyDashboardToOutputForRun" AfterTargets="Build"
          Condition="'$(SkipDashboardBuild)' != 'true' AND Exists('$(MSBuildProjectDirectory)\wwwroot')">
    <ItemGroup>
      <DashboardOutputFiles Include="$(MSBuildProjectDirectory)\wwwroot\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DashboardOutputFiles)"
          DestinationFolder="$(OutDir)wwwroot\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="AddDashboardFilesToPublish" AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="CopyDashboardToWwwroot"
          Condition="'$(SkipDashboardBuild)' != 'true' AND Exists('$(MSBuildProjectDirectory)\wwwroot')">
    <ItemGroup>
      <DashboardPublishFiles Include="$(MSBuildProjectDirectory)\wwwroot\**\*.*" />
      <ResolvedFileToPublish Include="@(DashboardPublishFiles)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
