<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Context.Application\Context.Application.csproj" />
    <ProjectReference Include="..\..\..\..\src\Context.Infrastructure\Context.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\src\Context.Claude\Context.Claude.csproj" />
  </ItemGroup>

  <!-- BACKLOG-10 / SEC-6: lets Context.IntegrationTests assert on HookEndpoints.FormatContextPack's
       prompt-injection framing (WrapAsRetrievedData) without making it public API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Context.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>context-platform-host</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Dev-inner-loop only (mirrors the `dotnet new angular` SpaProxy shape — see
    apps/host/Template's reference scaffold): when ASPNETCORE_HOSTINGSTARTUPASSEMBLIES=
    Microsoft.AspNetCore.SpaProxy is set (Properties/launchSettings.json), unmatched requests are
    forwarded to the Angular dev server (`npm start`, auto-launched) at SpaProxyServerUrl. This
    does NOT bundle the Dashboard into wwwroot/ for `dotnet publish` — unlike the old MSBuild
    Exec-target approach this replaced, production packaging is a separate, explicit step (already
    true for Docker — see Dockerfile's dashboard-build stage; bare-metal Windows-service/systemd
    deploys need one too, see deploy/README.md).
  -->
  <PropertyGroup>
    <SpaRoot>..\context.dashboard.client</SpaRoot>
    <SpaProxyServerUrl>http://localhost:4200</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
  </PropertyGroup>

</Project>
