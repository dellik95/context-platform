<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Context.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Context.Domain\Context.Domain.csproj" />
    <ProjectReference Include="..\Context.Shared\Context.Shared.csproj" />
    <ProjectReference Include="..\Context.Infrastructure\Context.Infrastructure.csproj" />
    <ProjectReference Include="..\Context.Indexing\Context.Indexing.csproj" />
    <ProjectReference Include="..\Context.Graph\Context.Graph.csproj" />
    <ProjectReference Include="..\Context.Retrieval\Context.Retrieval.csproj" />
    <ProjectReference Include="..\Context.Memory\Context.Memory.csproj" />
    <ProjectReference Include="..\Context.Providers\Context.Providers.csproj" />
    <ProjectReference Include="..\Context.Claude\Context.Claude.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- SqliteChunkVectorIndex: real ANN vector search backing ISearchIndex.VectorSearchAsync
         (see Adapters/SqliteChunkVectorIndex.cs). -->
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.SqliteVec" />
    <!-- IndexingPipeline.IndexUnparsedFileAsync: DocumentTokenChunker for real multi-chunk splitting
         of large doc/markdown/config files, instead of one whole-file chunk. -->
    <PackageReference Include="Microsoft.Extensions.DataIngestion" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
