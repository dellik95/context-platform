<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Context.Domain\Context.Domain.csproj" />
    <ProjectReference Include="..\Context.Shared\Context.Shared.csproj" />
  </ItemGroup>

  <!-- BACKLOG-07: lets Context.Infrastructure.Tests construct DbContextOptions with the internal
       SqlitePragmaConnectionInterceptor directly, the same way ServiceCollectionExtensions.
       AddContextInfrastructure does, to assert the busy_timeout pragma is actually applied. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Context.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
